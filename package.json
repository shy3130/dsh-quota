{
  "name": "@local/dsh-quota",
  "version": "1.1.0",
  "private": true,
  "description": "在输入框下方跟随当前模型显示对应厂商的套餐额度：智谱 GLM（5 小时 / 本周 / 工具额度）与 OpenCode Go（5 小时 / 本周 / 本月）；可扩展更多厂商。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shy3130/dsh-quota.git"
  },
  "homepage": "https://github.com/shy3130/dsh-quota#readme",
  "bugs": {
    "url": "https://github.com/shy3130/dsh-quota/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "quota",
    "statusline",
    "glm",
    "opencode"
  ]
}
