{
  "name": "@local/dsh-quota",
  "version": "1.3.0",
  "private": true,
  "description": "DeepSeek Harness 状态栏多厂商额度监控插件：智谱 GLM、OpenCode Go、Kimi、小米 Token 套餐、DeepSeek 官方（余额 + 消耗估算），附今日/7天/30天 Token 用量统计。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shy3130/dsh-quota.git"
  },
  "homepage": "https://github.com/shy3130/dsh-quota#readme",
  "bugs": {
    "url": "https://github.com/shy3130/dsh-quota/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "quota",
    "statusline",
    "token-usage",
    "glm",
    "opencode",
    "kimi",
    "xiaomi",
    "deepseek"
  ],
  "license": "MIT"
}
